# Copy to .env. Secrets stay on the backend; never commit .env.
DEEPGRAM_API_KEY=
# Upload mode uses bundled base.en CPU INT8 models; no Hugging Face token needed.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b
# Optional chat-completions-compatible provider. Explicitly selected in the UI.
LLM_API_URL=
LLM_API_KEY=
LLM_API_MODEL=
# Optional: path to ffmpeg.exe. The launcher also detects the sibling Meetily binary.
FFMPEG_PATH=
